  "grammar": [
    {
      "id": "g1",
      "pattern": "N1 は N2 です",
      "explanation": "Dùng để nói N1 là N2. Trợ từ は đọc là 'wa'.",
      "examples": [
        {
          "japanese": "わたし は がくせい です。",
          "vietnamese": "Tôi là học sinh."
        },
        {
          "japanese": "マイク・ミラー は アメリカじん です。",
          "vietnamese": "Mike Miller là người Mỹ."
        }
      ]
    },
    {
      "id": "g2",
      "pattern": "N1 は N2 じゃありません",
      "explanation": "Thể phủ định của です, dùng để nói N1 không phải là N2.",
      "examples": [
        {
          "japanese": "わたし は せんせい じゃありません。",
          "vietnamese": "Tôi không phải là giáo viên."
        }
      ]
    },
    {
      "id": "g3",
      "pattern": "S か",
      "explanation": "Câu hỏi. Thêm か vào cuối câu để tạo thành câu hỏi.",
      "examples": [
        {
          "japanese": "あなたは がくせいですか。",
          "vietnamese": "Bạn có phải là học sinh không?"
        }
      ]
    }
  ]
