  "grammar": [
    {
      "id": "g1",
      "pattern": "これ / それ / あれ は N です",
      "structure": "これ / それ / あれ + は + Danh từ + です",
      "explanation": "Dùng để chỉ định một đồ vật và nêu rõ đồ vật đó là gì trong tương quan vị trí giữa người nói và người nghe. 'これ' chỉ vật ở gần người nói; 'それ' chỉ vật ở gần người nghe; 'あれ' chỉ vật ở xa cả hai người.",
      "usage": "Sử dụng làm chủ ngữ độc lập để xác định tên gọi của đồ vật xung quanh.",
      "notes": "Các từ これ, それ, あれ là đại từ chỉ định độc lập, KHÔNG được đặt một danh từ trực tiếp ngay sau nó (không dùng 'これ ほん', phải dùng 'この ほん'). Khi giao tiếp: nếu người hỏi dùng これ thì người nghe trả lời bằng それ (và ngược lại); nếu người hỏi dùng あれ thì người trả lời cũng dùng あれ.",
      "examples": [
        {
          "japanese": "これ は ほん です。",
          "furigana": "これ は [本](ほん) です。",
          "vietnamese": "Đây là cuốn sách."
        },
        {
          "japanese": "それ は わたし の かさ です。",
          "furigana": "それ は わたし の [傘](かさ) です。",
          "vietnamese": "Đó là chiếc ô của tôi."
        },
        {
          "japanese": "あれ は なんですか。",
          "furigana": "あれ は [何](なん)ですか。",
          "vietnamese": "Kia là cái gì vậy?"
        }
      ]
    },
    {
      "id": "g2",
      "pattern": "この N / その N / あの N は [Vị ngữ] です",
      "structure": "この / その / あの + Danh từ + は + Vị ngữ + です",
      "explanation": "Dùng để bổ nghĩa trực tiếp cho danh từ đứng ngay sau nó nhằm xác định cụ thể 'Cái N này / Cái N đó / Cái N kia'. 'この N' chỉ danh từ ở gần người nói; 'その N' chỉ danh từ ở gần người nghe; 'あの N' chỉ danh từ ở xa cả hai người.",
      "usage": "Nhóm từ この, その, あの luôn luôn phải có danh từ đi liền phía sau để tạo thành cụm danh từ hoàn chỉnh.",
      "notes": "Tuyệt đối không sử dụng riêng lẻ nhóm từ này làm chủ ngữ (không nói: 'この は わたしのです'; câu đúng phải là: 'この ほん は わたしのです').",
      "examples": [
        {
          "japanese": "この ほん は わたし の です。",
          "furigana": "この [本](ほん) は わたし の です。",
          "vietnamese": "Cuốn sách này là của tôi."
        },
        {
          "japanese": "その かぎ は あなた の ですか。",
          "furigana": "その [鍵](かぎ) は あなた の ですか。",
          "vietnamese": "Chiếc chìa khóa đó có phải của bạn không?"
        },
        {
          "japanese": "あの くるま は にほん の くるま です。",
          "furigana": "あの [車](くるま) は [日本](にほん) の [車](くるま) です。",
          "vietnamese": "Chiếc xe hơi kia là xe hơi của Nhật Bản."
        }
      ]
    },
    {
      "id": "g3",
      "pattern": "N1 の N2 & Câu hỏi 'だれの N2'",
      "structure": "N1 + の + N2 / だれの + N2 + ですか",
      "explanation": "Trợ từ 'の' dùng để liên kết 2 danh từ: (1) Biểu thị nội dung, chủng loại (N1 bổ nghĩa cho N2: sách tiếng Nhật, tạp chí ô tô); (2) Biểu thị quyền sở hữu (N1 là chủ của N2: sách của tôi, ô của giáo viên). Khi muốn hỏi người sở hữu đồ vật, ta dùng nghi vấn từ 'だれ' (ai) kết hợp với 'の'.",
      "usage": "Khi danh từ N2 đã được người nghe hiểu rõ qua ngữ cảnh hoặc câu hỏi trước đó, ta có thể giản lược N2 và chỉ cần nói 'N1 の です' (Ví dụ: 'わたしのです' - Của tôi).",
      "notes": "Nếu danh từ N2 là từ chỉ người (ví dụ: がくせい - học sinh, しゃいん - nhân viên công ty), ta KHÔNG được giản lược N2.",
      "examples": [
        {
          "japanese": "これ は にほんご の ほん です。",
          "furigana": "これ は [日本語](にほんご) の [本](ほん) です。",
          "vietnamese": "Đây là sách tiếng Nhật."
        },
        {
          "japanese": "それ は だれ の かばん ですか。",
          "furigana": "それ は [誰](だれ) の かばん ですか。",
          "vietnamese": "Đó là chiếc cặp của ai vậy?"
        },
        {
          "japanese": "この かさ は たなかさん の です。",
          "furigana": "この [傘](かさ) は [田中](たなか)さん の です。",
          "vietnamese": "Chiếc ô này là của anh Tanaka."
        }
      ]
    }
